# ---------- Tier 3: schema manipulation ----------

def _mandatory_base_fields(space: str) -> list[dict[str, Any]]:
    """Return the 5 required base fields for a new Fibery type.

    When the holder type is secured, Fibery rejects explicit fibery/secured?: false
    on the child fields. Omit the flag so Fibery applies its own default.
    """
    return [
        {"fibery/name": "fibery/id", "fibery/type": "fibery/uuid",
         "fibery/meta": {"fibery/id?": True, "fibery/readonly?": True}},
        {"fibery/name": "fibery/public-id", "fibery/type": "fibery/text",
         "fibery/meta": {"fibery/public-id?": True, "fibery/readonly?": True}},
        {"fibery/name": "fibery/creation-date", "fibery/type": "fibery/date-time",
         "fibery/meta": {"fibery/creation-date?": True, "fibery/readonly?": True,
                         "fibery/default-value": "$now"}},
        {"fibery/name": "fibery/modification-date", "fibery/type": "fibery/date-time",
         "fibery/meta": {"fibery/modification-date?": True, "fibery/required?": True,
                         "fibery/readonly?": True, "fibery/default-value": "$now"}},
        {"fibery/name": f"{space}/name", "fibery/type": "fibery/text",
         "fibery/meta": {"ui/title?": True}},
    ]


def cmd_schema(ctx: Ctx, args: argparse.Namespace) -> None:
    """Dispatch schema subcommands."""
    op = args.schema_op
    if op == "dump":
        result = post_command(ctx, "fibery.schema/query", {"with-description?": True})
        emit(result, args.output)
        return

    if op == "create-type":
        full_name = f"{args.space}/{args.name}"
        meta = {
            "fibery/domain?": True,
            "fibery/secured?": True,
            "ui/color": args.color or "#F7D130",
        }
        commands = [
            {"command": "schema.type/create", "args": {
                "fibery/name": full_name,
                "fibery/meta": meta,
                "fibery/fields": _mandatory_base_fields(args.space),
            }},
        ]
        mixins_list = [m.strip() for m in (args.with_mixins or "fibery/rank-mixin").split(",") if m.strip()]
        if mixins_list:
            commands.append({"command": "fibery.app/install-mixins", "args": {
                "types": {full_name: mixins_list}
            }})
        result = post_command(ctx, "fibery.schema/batch", {"commands": commands})
        emit({"created": full_name, "mixins": mixins_list, "result": result}, args.output)
        return

    if op == "create-field":
        meta = json.loads(args.meta) if args.meta else {}
        field_type = args.field_type

        # Shorthand: --ui-type email/phone/url sets fibery/text + ui/type meta
        if args.ui_type:
            if args.ui_type in ("email", "phone", "url"):
                field_type = "fibery/text"
                meta["ui/type"] = args.ui_type
            elif args.ui_type == "people":
                field_type = "fibery/user"
                meta.setdefault("fibery/collection?", True)
            else:
                print(f"[fibery] ERROR: unknown --ui-type '{args.ui_type}' (email, phone, url, people)", file=sys.stderr)
                sys.exit(EXIT_USER_ERROR)

        # Money formatting shorthand
        if args.money:
            meta["ui/number-format"] = "Money"
            meta["ui/number-currency-code"] = args.currency or "USD"
            meta["ui/number-precision"] = 2
            meta["ui/number-thousand-separator?"] = True

        if args.percent:
            meta["ui/number-format"] = "Percent"
            meta["ui/number-precision"] = args.precision if args.precision is not None else 1

        if args.precision is not None and "ui/number-precision" not in meta:
            meta["ui/number-precision"] = args.precision

        result = post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.field/create", "args": {
                "fibery/holder-type": args.type,
                "fibery/name": args.name,
                "fibery/type": field_type,
                "fibery/meta": meta,
            }},
        ]})
        emit({"created": args.name, "holder": args.type, "type": field_type, "meta": meta, "result": result}, args.output)
        return

    if op == "create-relation":
        import uuid as _uuid
        relation_uuid = str(_uuid.uuid4())
        cardinality = args.cardinality
        from_collection = cardinality in ("many-to-many", "one-to-many")
        to_collection = cardinality in ("many-to-many", "many-to-one")
        commands = [
            {"command": "schema.field/create", "args": {
                "fibery/holder-type": args.from_type,
                "fibery/name": args.name_forward,
                "fibery/type": args.to_type,
                "fibery/meta": {
                    "fibery/relation": relation_uuid,
                    "fibery/collection?": from_collection,
                },
            }},
            {"command": "schema.field/create", "args": {
                "fibery/holder-type": args.to_type,
                "fibery/name": args.name_back,
                "fibery/type": args.from_type,
                "fibery/meta": {
                    "fibery/relation": relation_uuid,
                    "fibery/collection?": to_collection,
                },
            }},
        ]
        result = post_command(ctx, "fibery.schema/batch", {"commands": commands})
        emit({
            "relation": relation_uuid,
            "cardinality": cardinality,
            "from": f"{args.from_type}.{args.name_forward}",
            "to": f"{args.to_type}.{args.name_back}",
            "result": result,
        }, args.output)
        return

    if op == "rename-type":
        # NOTE: schema.type/rename uses plain keys (no fibery/ prefix)
        result = post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.type/rename", "args": {
                "from-name": args.old,
                "to-name": args.new,
            }},
        ]})
        emit({"renamed": args.old, "to": args.new, "result": result}, args.output)
        return

    if op == "rename-field":
        # NOTE: schema.field/rename uses plain keys (no fibery/ prefix)
        result = post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.field/rename", "args": {
                "holder-type": args.type,
                "from-name": args.old,
                "to-name": args.new,
            }},
        ]})
        emit({"renamed": args.old, "to": args.new, "holder": args.type, "result": result}, args.output)
        return

    if op == "delete-type":
        if not args.yes:
            print("[fibery] ERROR: delete-type requires --yes", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)
        result = post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.type/delete", "args": {
                "name": args.type,
                "delete-entities?": bool(args.delete_entities),
                "delete-related-fields?": True,
            }},
        ]})
        emit({"deleted": args.type, "result": result}, args.output)
        return

    if op == "delete-field":
        if not args.yes:
            print("[fibery] ERROR: delete-field requires --yes", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)
        result = post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.field/delete", "args": {
                "holder-type": args.type,
                "name": args.name,
                "delete-values?": bool(args.delete_values),
            }},
        ]})
        emit({"deleted": args.name, "holder": args.type, "result": result}, args.output)
        return

    if op == "set-field-meta":
        # NOTE: schema.field/set-meta takes ONE key/value per call. We expand a
        # --meta JSON object into one command per entry inside a single batch.
        meta = json.loads(args.meta)
        if not isinstance(meta, dict):
            print("[fibery] ERROR: --meta must be a JSON object", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)
        commands = [
            {"command": "schema.field/set-meta", "args": {
                "holder-type": args.type,
                "name": args.name,
                "key": k,
                "value": v,
            }}
            for k, v in meta.items()
        ]
        result = post_command(ctx, "fibery.schema/batch", {"commands": commands})
        emit({"updated": args.name, "holder": args.type, "meta": meta, "result": result}, args.output)
        return

    if op == "install-mixins":
        mixins_list = [m.strip() for m in args.mixins.split(",") if m.strip()]
        result = post_command(ctx, "fibery.app/install-mixins", {
            "types": {args.type: mixins_list}
        })
        emit({"installed": mixins_list, "holder": args.type, "result": result}, args.output)
        return

    if op == "batch":
        with open(args.file) as f:
            commands = json.load(f)
        if not isinstance(commands, list):
            print("[fibery] ERROR: batch file must be a JSON array of commands", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)
        result = post_command(ctx, "fibery.schema/batch", {"commands": commands})
        emit(result, args.output)
        return

    if op == "diff":
        with open(args.file) as f:
            target = json.load(f)
        live = post_command(ctx, "fibery.schema/query", {"with-description?": False})
        diff = _schema_diff(live, target)
        emit(diff, args.output)
        return

    if op == "create-enum":
        import uuid as _uuid
        # Enum type naming: Space/FieldName_Space/HolderType
        enum_type_name = f"{args.name}_{args.type}"
        relation_uuid = str(_uuid.uuid4())
        is_multi = args.multi

        schema_cmds = [
            {"command": "schema.enum/create", "args": {
                "fibery/name": enum_type_name,
                "fibery/meta": {"fibery/type-component?": True},
            }},
            {"command": "schema.field/create", "args": {
                "fibery/holder-type": args.type,
                "fibery/name": args.name,
                "fibery/type": enum_type_name,
                "fibery/meta": {
                    "fibery/collection?": is_multi,
                    "fibery/type-component?": True,
                    "fibery/relation": relation_uuid,
                },
            }},
            {"command": "schema.field/create", "args": {
                "fibery/holder-type": enum_type_name,
                "fibery/name": f"{args.name.rsplit('/', 1)[0]}/entities",
                "fibery/type": args.type,
                "fibery/meta": {
                    "fibery/collection?": True,
                    "fibery/relation": relation_uuid,
                },
            }},
        ]

        batch_cmds: list[dict[str, Any]] = [
            {"command": "fibery.schema/batch", "args": {"commands": schema_cmds}},
        ]

        if args.options:
            option_names = [o.strip() for o in args.options.split(",") if o.strip()]
            batch_cmds.append({
                "command": "fibery.entity.batch/create",
                "args": {
                    "type": enum_type_name,
                    "entities": [
                        {"enum/name": name, "fibery/rank": i * 1000000, "enum/color": None, "enum/icon": None}
                        for i, name in enumerate(option_names)
                    ],
                },
            })

        result = post_command(ctx, "fibery.command/batch", {"commands": batch_cmds})
        emit({
            "created": args.name,
            "enum_type": enum_type_name,
            "multi_select": is_multi,
            "options": args.options,
            "result": result,
        }, args.output)
        return

    if op == "create-rich-text":
        result = post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.field/create", "args": {
                "fibery/holder-type": args.type,
                "fibery/name": args.name,
                "fibery/type": "Collaboration~Documents/Document",
                "fibery/meta": {
                    "fibery/entity-component?": True,
                    "ui/object-editor-order": -1,
                },
            }},
        ]})
        emit({"created": args.name, "holder": args.type, "result": result}, args.output)
        return

    if op == "create-files":
        result = post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.field/create", "args": {
                "fibery/holder-type": args.type,
                "fibery/name": args.name,
                "fibery/type": "fibery/file",
                "fibery/meta": {
                    "fibery/collection?": True,
                    "fibery/entity-component?": True,
                },
            }},
        ]})
        emit({"created": args.name, "holder": args.type, "type": "fibery/file", "result": result}, args.output)
        return

    if op == "delete-field-meta":
        result = post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.field/delete-meta", "args": {
                "holder-type": args.type,
                "name": args.name,
                "key": args.key,
            }},
        ]})
        emit({"deleted_key": args.key, "field": args.name, "holder": args.type, "result": result}, args.output)
        return

    if op == "reorder-fields":
        fields = [f.strip() for f in args.fields.split(",") if f.strip()]
        commands = [
            {"command": "schema.field/set-meta", "args": {
                "holder-type": args.type,
                "name": field,
                "key": "ui/object-editor-order",
                "value": i,
            }}
            for i, field in enumerate(fields)
        ]
        result = post_command(ctx, "fibery.schema/batch", {"commands": commands})
        emit({
            "reordered": len(fields),
            "holder": args.type,
            "order": [{"position": i, "field": f} for i, f in enumerate(fields)],
            "result": result,
        }, args.output)
        return

    if op == "convert-field":
        if not args.yes:
            print("[fibery] ERROR: convert-field requires --yes (data in this field will be lost)", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)
        # Step 1: delete old field
        post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.field/delete", "args": {
                "holder-type": args.type,
                "name": args.name,
                "delete-values?": True,
            }},
        ]})
        # Step 2: create with new type
        meta = json.loads(args.meta) if args.meta else {}
        post_command(ctx, "fibery.schema/batch", {"commands": [
            {"command": "schema.field/create", "args": {
                "fibery/holder-type": args.type,
                "fibery/name": args.name,
                "fibery/type": args.new_type,
                "fibery/meta": meta,
            }},
        ]})
        emit({"converted": args.name, "holder": args.type, "new_type": args.new_type, "data_lost": True}, args.output)
        return

    if op == "create-workflow":
        import uuid as _uuid
        state_types = {"Not started": [], "Started": [], "Finished": []}
        for s in args.states.split("|"):
            s = s.strip()
            if ":" in s:
                name, category = s.rsplit(":", 1)
                category = category.strip()
            else:
                name = s
                category = "Not started"
            valid = {"not started": "Not started", "started": "Started", "finished": "Finished",
                     "not_started": "Not started", "todo": "Not started", "done": "Finished",
                     "in_progress": "Started", "cancelled": "Finished"}
            category = valid.get(category.lower(), category)
            state_types.setdefault(category, [])
            state_types[category].append(name.strip())

        states = []
        for cat in ["Not started", "Started", "Finished"]:
            for name in state_types.get(cat, []):
                states.append({
                    "fibery/id": str(_uuid.uuid4()),
                    "enum/name": name,
                    "enum/color": None,
                    "enum/icon": None,
                    "workflow/Type": cat,
                })

        if not states:
            print("[fibery] ERROR: --states required (e.g. 'To Do:todo|In Progress:started|Done:done')", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)

        default_id = states[0]["fibery/id"]
        result = post_command(ctx, "workflow/install", {
            "type": args.type,
            "states": states,
            "default-state-id": default_id,
        })
        emit({
            "installed": "workflow",
            "holder": args.type,
            "states": [{"name": s["enum/name"], "category": s["workflow/Type"]} for s in states],
            "default": states[0]["enum/name"],
            "result": result,
        }, args.output)
        return

    if op == "create-formula":
        body = json.loads(args.body) if args.body else {}
        if args.body_file:
            with open(args.body_file) as f:
                body = json.load(f)
        if not body:
            print("[fibery] ERROR: create-formula needs --body or --body-file with field-creator payload", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)
        r = ctx.client.post(
            ctx.url("/api/field-creator/field"),
            headers=ctx.headers(),
            json={"fieldObject": body},
            timeout=30.0,
        )
        if not r.is_success:
            http_error(r)
        emit(r.json(), args.output)
        return

    print(f"[fibery] ERROR: unknown schema op '{op}'", file=sys.stderr)
    sys.exit(EXIT_USER_ERROR)


def _schema_diff(live: dict[str, Any], target: dict[str, Any]) -> dict[str, Any]:
    """Compare live schema to target schema by type name. Types only for MVP."""
    def type_map(schema: dict[str, Any]) -> dict[str, dict[str, Any]]:
        return {t.get("fibery/name"): t for t in schema.get("fibery/types", [])}

    live_types = type_map(live)
    target_types = type_map(target)

    only_live = sorted(set(live_types) - set(target_types))
    only_target = sorted(set(target_types) - set(live_types))
    shared = sorted(set(live_types) & set(target_types))

    field_diffs = {}
    for name in shared:
        lf = {f.get("fibery/name") for f in live_types[name].get("fibery/fields", [])}
        tf = {f.get("fibery/name") for f in target_types[name].get("fibery/fields", [])}
        added = sorted(tf - lf)
        removed = sorted(lf - tf)
        if added or removed:
            field_diffs[name] = {"added": added, "removed": removed}

    return {
        "types_only_live": only_live,
        "types_only_target": only_target,
        "field_diffs": field_diffs,
    }


def cmd_file(ctx: Ctx, args: argparse.Namespace) -> None:
    """File download, upload, or sign-url operations."""
    if args.file_op == "download":
        r = ctx.client.get(ctx.url(f"/api/files/{args.secret}"), headers=ctx.headers(), timeout=60.0, follow_redirects=True)
        if not r.is_success:
            http_error(r)
        if args.out:
            with open(args.out, "wb") as f:
                f.write(r.content)
            emit({"saved": args.out, "bytes": len(r.content), "content_type": r.headers.get("content-type")}, args.output)
        else:
            sys.stdout.buffer.write(r.content)
    elif args.file_op == "upload":
        with open(args.path, "rb") as f:
            files = {"file": (args.path.split("/")[-1], f)}
            headers = {"Authorization": f"Token {ctx.token}"}
            r = ctx.client.post(ctx.url("/api/files"), headers=headers, files=files, timeout=120.0)
        if not r.is_success:
            http_error(r)
        emit(r.json(), args.output)
    elif args.file_op == "sign":
        r = ctx.client.post(
            ctx.url("/api/files/sign-urls"),
            headers=ctx.headers(),
            json={"files": [args.secret]},
            timeout=30.0,
        )
        if not r.is_success:
            http_error(r)
        emit(r.json(), args.output)

    elif args.file_op == "upload-multi":
        import time as _time
        paths = [p.strip() for p in args.paths.split(",") if p.strip()]
        results = []
        for path in paths:
            with open(path, "rb") as f:
                files_payload = {"file": (path.split("/")[-1], f)}
                headers = {"Authorization": f"Token {ctx.token}"}
                r = ctx.client.post(ctx.url("/api/files"), headers=headers, files=files_payload, timeout=120.0)
            if not r.is_success:
                results.append({"path": path, "error": f"HTTP {r.status_code}"})
            else:
                results.append(r.json())
            if len(paths) > 1:
                _time.sleep(0.35)
        emit(results, args.output)

    elif args.file_op == "attach":
        import time as _time
        paths = [p.strip() for p in args.paths.split(",") if p.strip()]
        uploaded = []
        for path in paths:
            with open(path, "rb") as f:
                files_payload = {"file": (path.split("/")[-1], f)}
                headers = {"Authorization": f"Token {ctx.token}"}
                r = ctx.client.post(ctx.url("/api/files"), headers=headers, files=files_payload, timeout=120.0)
            if not r.is_success:
                print(f"[fibery] ERROR: upload failed for {path}: HTTP {r.status_code}", file=sys.stderr)
                continue
            uploaded.append(r.json())
            _time.sleep(0.35)
        if not uploaded:
            print("[fibery] ERROR: no files uploaded successfully", file=sys.stderr)
            sys.exit(EXIT_API_ERROR)
        items = [{"fibery/id": u["fibery/id"]} for u in uploaded]
        post_command(ctx, "fibery.entity/add-collection-items", {
            "type": args.type,
            "entity": {"fibery/id": args.entity_id},
            "field": args.field,
            "items": items,
        })
        emit({
            "attached": len(uploaded),
            "entity": args.entity_id,
            "field": args.field,
            "files": [{"name": u.get("fibery/name"), "id": u.get("fibery/id"), "secret": u.get("fibery/secret")} for u in uploaded],
        }, args.output)

    elif args.file_op == "list-on":
        result = post_command(ctx, "fibery.entity/query", {
            "query": {
                "q/from": args.type,
                "q/select": {
                    "fibery/id": ["fibery/id"],
                    "files": {
                        "q/from": [args.field],
                        "q/select": {
                            "fibery/id": ["fibery/id"],
                            "name": ["fibery/name"],
                            "secret": ["fibery/secret"],
                            "content-type": ["fibery/content-type"],
                            "size": ["fibery/content-length"],
                        },
                        "q/limit": "q/no-limit",
                    },
                },
                "q/where": ["=", ["fibery/id"], "$eid"],
                "q/limit": 1,
            },
            "params": {"$eid": args.entity_id},
        })
        files = result[0].get("files", []) if result else []
        emit(files, args.output)

    elif args.file_op == "download-all":
        from pathlib import Path
        import time as _time
        result = post_command(ctx, "fibery.entity/query", {
            "query": {
                "q/from": args.type,
                "q/select": {
                    "files": {
                        "q/from": [args.field],
                        "q/select": {
                            "name": ["fibery/name"],
                            "secret": ["fibery/secret"],
                        },
                        "q/limit": "q/no-limit",
                    },
                },
                "q/where": ["=", ["fibery/id"], "$eid"],
                "q/limit": 1,
            },
            "params": {"$eid": args.entity_id},
        })
        files = result[0].get("files", []) if result else []
        if not files:
            emit({"downloaded": 0, "message": "no files"}, args.output)
            return
        out_dir = Path(args.out_dir)
        out_dir.mkdir(parents=True, exist_ok=True)
        downloaded = []
        for fi in files:
            secret = fi.get("secret")
            name = fi.get("name", secret)
            r = ctx.client.get(ctx.url(f"/api/files/{secret}"), headers=ctx.headers(), timeout=60.0, follow_redirects=True)
            if r.is_success:
                out_path = out_dir / name
                with open(out_path, "wb") as f:
                    f.write(r.content)
                downloaded.append({"name": name, "bytes": len(r.content), "path": str(out_path)})
            _time.sleep(0.35)
        emit({"downloaded": len(downloaded), "files": downloaded}, args.output)


# ---------- Argparse ----------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="fibery",
        description="CLI for Fibery workspaces",
    )
    parser.add_argument("workspace", help="Workspace alias from config, e.g. 'myworkspace'")
    parser.add_argument(
        "--workspace-host",
        help="Direct workspace host, e.g. myworkspace.fibery.io",
    )
    parser.add_argument(
        "--token",
        help="Direct API token. Overrides FIBERY_TOKEN and Keychain lookup.",
    )
    parser.add_argument("-o", "--output", choices=["json", "raw", "table"], default="json",
                        help="Output format (default: json)")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("date", help="Current date and workspace info")

    p_dbs = sub.add_parser("dbs", help="List databases in the workspace")
    p_dbs.add_argument("--all", action="store_true", help="Include system/enum types (default: domain types only)")

    p_describe = sub.add_parser("describe", help="Describe fields and meta for one database")
    p_describe.add_argument("type", help="Database name, e.g. 'Task Management/Task'")

    p_query = sub.add_parser("query", help="Query entities from a database")
    p_query.add_argument("type", help="Database name, e.g. 'Task Management/Task'")
    p_query.add_argument("--where", action="append", default=[],
                         help="Filter clause: Field=value, Field!=value, Field>value, Field<value. Repeatable (ANDed).")
    p_query.add_argument("--select", default=None,
                         help="Comma-separated field paths. Use dots for nested: 'Name,State.enum/name'")
    p_query.add_argument("--limit", type=int, default=50)
    p_query.add_argument("--offset", type=int, default=0)
    p_query.add_argument("--order-by", default=None, help="Field name to order by")
    p_query.add_argument("--order-desc", action="store_true", help="Order descending (default: ascending)")
    p_query.add_argument("--json-query", default=None,
                         help="Raw q/ DSL as JSON. Bypasses --where/--select/--limit.")
    p_query.add_argument("--params", default=None,
                         help="Query parameters as JSON object (used with --json-query)")

    p_create = sub.add_parser("create", help="Create an entity in a database")
    p_create.add_argument("type", help="Database name")
    p_create.add_argument("--fields", default=None, help="Entity fields as JSON object")
    p_create.add_argument("--fields-file", default=None, help="Path to JSON file with entity fields")

    p_update = sub.add_parser("update", help="Update an entity by ID")
    p_update.add_argument("id", help="Entity fibery/id (UUID)")
    p_update.add_argument("--type", required=True, help="Database name (required)")
    p_update.add_argument("--fields", default=None, help="Fields to update as JSON object")
    p_update.add_argument("--fields-file", default=None, help="Path to JSON file with fields")

    p_batch = sub.add_parser("batch-create", help="Create many entities from a JSON array file")
