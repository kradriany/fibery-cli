#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx"]
# ///

"""
fibery - CLI for Fibery workspaces

Replaces the Fibery MCP server with a standalone Python CLI.
Reads API tokens from --token, FIBERY_TOKEN, or macOS Keychain.

Examples:
    fibery myworkspace date
    fibery myworkspace dbs
    fibery myworkspace describe "Task Management/Task"
    fibery myworkspace query "Task Management/Task" --where 'State=Open' --limit 5
    fibery myworkspace create "Task Management/Task" --fields '{"Name":"hello"}'
    fibery myworkspace comments <entity-id>
    fibery myworkspace doc <secret> --format md
    fibery myworkspace schema dump
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

import httpx


# ---------- Workspace + credentials ----------

KEYCHAIN_SERVICE = "mcp-credentials"
CONFIG_ENV_VAR = "FIBERY_CONFIG_FILE"

EXIT_OK = 0
EXIT_USER_ERROR = 1
EXIT_API_ERROR = 2
EXIT_AUTH_ERROR = 3


def config_path() -> Path:
    override = os.environ.get(CONFIG_ENV_VAR)
    if override:
        return Path(override).expanduser()
    if os.name == "nt":
        base = Path(os.environ.get("APPDATA", Path.home() / "AppData" / "Roaming"))
    else:
        base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return base / "fibery-cli" / "config.json"


def load_config() -> dict[str, Any]:
    path = config_path()
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text())
    except OSError as exc:
        print(f"[fibery] ERROR: Failed to read config file '{path}': {exc}", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)
    except json.JSONDecodeError as exc:
        print(f"[fibery] ERROR: Invalid JSON in config file '{path}': {exc}", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)
    if not isinstance(data, dict):
        print(f"[fibery] ERROR: Config file '{path}' must contain a JSON object", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)
    return data


def _mapping_lookup(mapping: Any, key: str) -> Any:
    if not isinstance(mapping, dict):
        return None
    for name, value in mapping.items():
        if isinstance(name, str) and name.lower() == key.lower():
            return value
    return None


def _available_workspace_aliases(config: dict[str, Any]) -> list[str]:
    aliases: set[str] = set()
    for section in ("workspaces", "workspace_hosts"):
        mapping = config.get(section)
        if isinstance(mapping, dict):
            aliases.update(name for name in mapping if isinstance(name, str))
    return sorted(aliases)


def normalize_host(host: str) -> str:
    value = host.strip()
    if value.startswith("https://"):
        value = value.removeprefix("https://")
    elif value.startswith("http://"):
        value = value.removeprefix("http://")
    return value.rstrip("/")


def resolve_host(workspace: str, *, workspace_host: str | None = None, config: dict[str, Any] | None = None) -> str:
    if workspace_host:
        return normalize_host(workspace_host)

    config = config or {}
    workspace_entry = _mapping_lookup(config.get("workspaces"), workspace)
    if isinstance(workspace_entry, dict):
        host = workspace_entry.get("host")
        if isinstance(host, str) and host.strip():
            return normalize_host(host)

    host = _mapping_lookup(config.get("workspace_hosts"), workspace)
    if isinstance(host, str) and host.strip():
        return normalize_host(host)

    print(
        f"[fibery] ERROR: Unknown workspace '{workspace}'. "
        f"Add it to '{config_path()}' or pass --workspace-host.",
        file=sys.stderr,
    )
    available = _available_workspace_aliases(config)
    if available:
        print(f"[fibery] Available aliases: {', '.join(available)}", file=sys.stderr)
    sys.exit(EXIT_USER_ERROR)


def resolve_keychain_account(
    workspace: str,
    host: str,
    *,
    config: dict[str, Any] | None = None,
) -> str:
    env_account = os.environ.get("FIBERY_KEYCHAIN_ACCOUNT")
    if env_account:
        return env_account

    config = config or {}
    workspace_entry = _mapping_lookup(config.get("workspaces"), workspace)
    if isinstance(workspace_entry, dict):
        account = workspace_entry.get("keychain_account")
        if isinstance(account, str) and account.strip():
            return account

    account = _mapping_lookup(config.get("keychain_accounts"), host)
    if isinstance(account, str) and account.strip():
        return account

    return f"fibery-{workspace.lower()}"


def get_token(
    host: str,
    *,
    workspace: str,
    token: str | None = None,
    config: dict[str, Any] | None = None,
) -> str:
    if token:
        return token

    env_token = os.environ.get("FIBERY_TOKEN")
    if env_token:
        return env_token

    account = resolve_keychain_account(workspace, host, config=config)
    try:
        result = subprocess.run(
            ["security", "find-generic-password", "-a", account, "-s", KEYCHAIN_SERVICE, "-w"],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    print(
        f"[fibery] ERROR: No credential found for workspace '{workspace}'. "
        "Use --token, set FIBERY_TOKEN, or configure macOS Keychain access.",
        file=sys.stderr,
    )
    print(
        f"[fibery] macOS Keychain example: security add-generic-password -U -a {account} "
        f"-s {KEYCHAIN_SERVICE} -w 'TOKEN'",
        file=sys.stderr,
    )
    sys.exit(EXIT_AUTH_ERROR)


# ---------- HTTP context ----------

@dataclass
class Ctx:
    workspace: str
    host: str
    token: str
    client: httpx.Client

    def url(self, path: str) -> str:
        return f"https://{self.host}{path}"

    def headers(self, content_type: str = "application/json") -> dict[str, str]:
        return {
            "Authorization": f"Token {self.token}",
            "Content-Type": content_type,
        }


def http_error(response: httpx.Response) -> None:
    """Print a helpful error and exit."""
    status = response.status_code
    body = response.text[:500]
    if status == 401:
        print("[fibery] ERROR: 401 Unauthorized - token expired or invalid", file=sys.stderr)
        print(
            "[fibery] Refresh the token and retry with --token, FIBERY_TOKEN, "
            "or your configured credential store.",
            file=sys.stderr,
        )
        sys.exit(EXIT_AUTH_ERROR)
    if status == 429:
        retry = response.headers.get("retry-after", "?")
        print(f"[fibery] ERROR: 429 Rate limited (retry-after: {retry}s)", file=sys.stderr)
        print("[fibery] Fibery limits: 3 req/sec per token, 7 req/sec per workspace", file=sys.stderr)
        sys.exit(EXIT_API_ERROR)
    print(f"[fibery] ERROR: HTTP {status}: {body}", file=sys.stderr)
    sys.exit(EXIT_API_ERROR)


def post_commands(ctx: Ctx, commands: list[dict[str, Any]]) -> list[Any]:
    """POST /api/commands - returns list of results (one per command)."""
    r = ctx.client.post(ctx.url("/api/commands"), headers=ctx.headers(), json=commands, timeout=30.0)
    if not r.is_success:
        http_error(r)
    data = r.json()
    if not isinstance(data, list):
        return [data]
    return data


def post_command(ctx: Ctx, command: str, args: dict[str, Any] | None = None) -> Any:
    """POST a single command and return its result (unwrapped from success wrapper)."""
    payload = [{"command": command, "args": args or {}}]
    results = post_commands(ctx, payload)
    if not results:
        print(f"[fibery] ERROR: Empty response from {command}", file=sys.stderr)
        sys.exit(EXIT_API_ERROR)
    res = results[0]
    if isinstance(res, dict) and res.get("success") is False:
        message = res.get("result") or res.get("message") or res
        print(f"[fibery] ERROR: Command {command} failed: {json.dumps(message, indent=2, default=str)}", file=sys.stderr)
        sys.exit(EXIT_API_ERROR)
    if isinstance(res, dict) and "result" in res:
        return res["result"]
    return res


# ---------- Output ----------

def emit(data: Any, fmt: str = "json") -> None:
    if fmt == "raw":
        print(json.dumps(data, default=str))
    elif fmt == "table":
        print_table(data)
    else:
        print(json.dumps(data, indent=2, default=str))


def print_table(data: Any) -> None:
    """Basic table printing for lists of dicts. Falls back to JSON."""
    if not isinstance(data, list) or not data or not isinstance(data[0], dict):
        print(json.dumps(data, indent=2, default=str))
        return
    cols = list(data[0].keys())
    widths = {c: max(len(str(c)), max(len(str(row.get(c, ""))) for row in data)) for c in cols}
    header = " | ".join(c.ljust(widths[c]) for c in cols)
    sep = "-+-".join("-" * widths[c] for c in cols)
    print(header)
    print(sep)
    for row in data:
        print(" | ".join(str(row.get(c, "")).ljust(widths[c]) for c in cols))


# ---------- Commands ----------

def cmd_date(ctx: Ctx, args: argparse.Namespace) -> None:
    now = datetime.now(timezone.utc)
    emit({
        "iso": now.isoformat(),
        "date": now.date().isoformat(),
        "workspace": ctx.workspace,
        "host": ctx.host,
    }, args.output)


def cmd_dbs(ctx: Ctx, args: argparse.Namespace) -> None:
    """List databases (types) in the workspace.

    Default filters (matching fibery MCP tool behavior):
      - Domain types only (fibery/domain?: True)
      - Exclude types in the fibery/* system namespace
      - Exclude soft-deleted types (name ending in _deleted or containing _NxN_deleted)

    Use --all to bypass the filter and see every type in the workspace.
    """
    result = post_command(ctx, "fibery.schema/query", {"with-description?": False})
    types = result.get("fibery/types", []) if isinstance(result, dict) else result or []
    databases = []
    for t in types:
        name = t.get("fibery/name", "")
        meta = t.get("fibery/meta", {}) or {}
        is_domain = meta.get("fibery/domain?", False)
        is_enum = meta.get("fibery/enum?", False)
        if not args.all:
            if not is_domain or is_enum:
                continue
            # System namespace
            if name.startswith("fibery/"):
                continue
            # Soft-deleted types have '_deleted' in the name
            if "_deleted" in name:
                continue
        databases.append({
            "name": name,
            "domain": is_domain,
            "secured": meta.get("fibery/secured?", False),
            "color": meta.get("ui/color", ""),
        })
    databases.sort(key=lambda d: d["name"])
    emit(databases, args.output)


def _get_type(ctx: Ctx, type_name: str) -> dict[str, Any]:
    """Fetch a single type's schema by name."""
    result = post_command(ctx, "fibery.schema/query", {"with-description?": True})
    types = result.get("fibery/types", []) if isinstance(result, dict) else []
    for t in types:
        if t.get("fibery/name") == type_name:
            return t
    print(f"[fibery] ERROR: Type '{type_name}' not found in workspace {ctx.host}", file=sys.stderr)
    sys.exit(EXIT_USER_ERROR)


def cmd_describe(ctx: Ctx, args: argparse.Namespace) -> None:
    """Describe the fields and metadata of a single database type."""
    target = _get_type(ctx, args.type)
    fields_out = []
    for f in target.get("fibery/fields", []):
        fields_out.append({
            "name": f.get("fibery/name"),
            "type": f.get("fibery/type"),
            "meta": f.get("fibery/meta", {}),
        })
    emit({
        "name": target.get("fibery/name"),
        "meta": target.get("fibery/meta", {}),
        "field_count": len(fields_out),
        "fields": fields_out,
    }, args.output)


def _parse_where(clause: str) -> tuple[str, str, str]:
    """Parse 'Field=value', 'Field!=value', 'Field>value', etc."""
    for op in ["!=", ">=", "<=", "=", ">", "<"]:
        if op in clause:
            field, value = clause.split(op, 1)
            return op, field.strip(), value.strip()
    print(f"[fibery] ERROR: Invalid --where clause '{clause}' (expected Field=value)", file=sys.stderr)
    sys.exit(EXIT_USER_ERROR)


def _coerce(value: str, hint: str | None) -> Any:
    """Coerce --where value based on optional type hint: int, float, bool, null.

    Default is string. Use 'Field:int=5' to force int. This avoids surprises
    with text fields that happen to contain numeric characters (e.g.
    fibery/public-id is text but looks like a number).
    """
    if hint is None or hint == "str":
        return value
    if hint == "int":
        return int(value)
    if hint == "float":
        return float(value)
    if hint == "bool":
        return value.lower() in ("true", "1", "yes", "y")
    if hint == "null":
        return None
    print(f"[fibery] ERROR: Unknown type hint ':{hint}' (allowed: int, float, bool, null, str)", file=sys.stderr)
    sys.exit(EXIT_USER_ERROR)


def _parse_field_hint(field: str) -> tuple[str, str | None]:
    """Split 'Field:int' into ('Field', 'int'). Returns (field, None) if no hint."""
    if ":" in field and not field.startswith("fibery/"):
        parts = field.rsplit(":", 1)
        if parts[1] in ("int", "float", "bool", "null", "str"):
            return parts[0], parts[1]
    return field, None


def _build_select(select_arg: str | None) -> dict[str, Any]:
    """Convert a comma-separated --select into a Fibery q/select dict.

    Field paths can use dots for nested traversal: `State.enum/name`.
    Always includes fibery/id and fibery/public-id unless explicitly listed.
    """
    if not select_arg:
        return {
            "fibery/id": ["fibery/id"],
            "fibery/public-id": ["fibery/public-id"],
        }
    result: dict[str, Any] = {}
    has_id = False
    for field in [f.strip() for f in select_arg.split(",") if f.strip()]:
        path = field.split(".")
        result[field] = path
        if field == "fibery/id":
            has_id = True
    if not has_id:
        result["fibery/id"] = ["fibery/id"]
    return result


def cmd_query(ctx: Ctx, args: argparse.Namespace) -> None:
    """Query entities from a database with --where/--select/--limit, or raw --json-query."""
    if args.json_query:
        query = json.loads(args.json_query)
        params = json.loads(args.params) if args.params else {}
    else:
        query: dict[str, Any] = {"q/from": args.type, "q/select": _build_select(args.select)}
        params: dict[str, Any] = {}
        if args.where:
            conditions = []
            for i, w in enumerate(args.where):
                op, raw_field, value = _parse_where(w)
                field, hint = _parse_field_hint(raw_field)
                param_name = f"$p{i}"
                params[param_name] = _coerce(value, hint)
                field_path = field.split(".")
                conditions.append([op, field_path, param_name])
            query["q/where"] = conditions[0] if len(conditions) == 1 else ["q/and"] + conditions
        if args.order_by:
            direction = "q/desc" if args.order_desc else "q/asc"
            query["q/order-by"] = [[[args.order_by], direction]]
        query["q/limit"] = args.limit
        if args.offset:
            query["q/offset"] = args.offset

    result = post_command(ctx, "fibery.entity/query", {"query": query, "params": params})
    emit(result, args.output)


def _load_fields(fields_arg: str | None, fields_file: str | None) -> dict[str, Any]:
    if fields_file:
        with open(fields_file) as f:
            return json.load(f)
    if fields_arg:
        return json.loads(fields_arg)
    return {}


def cmd_create(ctx: Ctx, args: argparse.Namespace) -> None:
    """Create a single entity in a database."""
    fields = _load_fields(args.fields, args.fields_file)
    if not fields:
        print("[fibery] ERROR: create requires --fields or --fields-file", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)
    result = post_command(ctx, "fibery.entity/create", {
        "type": args.type,
        "entity": fields,
    })
    emit(result, args.output)


def cmd_update(ctx: Ctx, args: argparse.Namespace) -> None:
    """Update an entity by ID. --type is required because Fibery demands it."""
    fields = _load_fields(args.fields, args.fields_file)
    entity = {"fibery/id": args.id, **fields}
    result = post_command(ctx, "fibery.entity/update", {
        "type": args.type,
        "entity": entity,
    })
    emit(result, args.output)


def cmd_batch_create(ctx: Ctx, args: argparse.Namespace) -> None:
    """Create many entities using fibery.entity.batch/create."""
    with open(args.file) as f:
        entities = json.load(f)
    if not isinstance(entities, list):
        print("[fibery] ERROR: batch-create file must be a JSON array of entities", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)
    result = post_command(ctx, "fibery.entity.batch/create", {
        "type": args.type,
        "entities": entities,
    })
    emit(result, args.output)


def cmd_delete(ctx: Ctx, args: argparse.Namespace) -> None:
    """Delete an entity by ID. Destructive - requires --yes."""
    if not args.yes:
        print("[fibery] ERROR: delete requires --yes to confirm destructive operation", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)
    result = post_command(ctx, "fibery.entity/delete", {
        "type": args.type,
        "entity": {"fibery/id": args.id},
    })
    emit(result, args.output)


def cmd_batch_delete(ctx: Ctx, args: argparse.Namespace) -> None:
    """Delete many entities by ID. Uses fibery.entity.batch/delete."""
    if not args.yes:
        print("[fibery] ERROR: batch-delete requires --yes", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)
    ids = [i.strip() for i in args.ids.split(",") if i.strip()]
    result = post_command(ctx, "fibery.entity.batch/delete", {
        "type": args.type,
        "entities": [{"fibery/id": i} for i in ids],
        "opts": {"fail-if-not-found?": False},
    })
    emit(result, args.output)


def cmd_link(ctx: Ctx, args: argparse.Namespace) -> None:
    """Add items to a collection/relation field on an entity."""
    if args.by_name:
        items = _resolve_items_by_name(ctx, args.type, args.field, args.by_name)
    else:
        ids = [i.strip() for i in args.items.split(",") if i.strip()]
        items = [{"fibery/id": i} for i in ids]
    result = post_command(ctx, "fibery.entity/add-collection-items", {
        "type": args.type,
        "entity": {"fibery/id": args.id},
        "field": args.field,
        "items": items,
    })
    emit(result, args.output)


def cmd_unlink(ctx: Ctx, args: argparse.Namespace) -> None:
    """Remove items from a collection/relation field on an entity."""
    if args.by_name:
        items = _resolve_items_by_name(ctx, args.type, args.field, args.by_name)
    else:
        ids = [i.strip() for i in args.items.split(",") if i.strip()]
        items = [{"fibery/id": i} for i in ids]
    result = post_command(ctx, "fibery.entity/remove-collection-items", {
        "type": args.type,
        "entity": {"fibery/id": args.id},
        "field": args.field,
        "items": items,
    })
    emit(result, args.output)


def _resolve_items_by_name(ctx: Ctx, holder_type: str, field_name: str, names_csv: str) -> list[dict[str, Any]]:
    """Look up target entities by name for --by-name on link/unlink.

    Inspects the field's target type from schema, queries for entities
    matching the provided names, returns their fibery/id entries.
    """
    schema = post_command(ctx, "fibery.schema/query", {})
    types = schema.get("fibery/types", [])
    target_type = None
    for t in types:
        if t.get("fibery/name") != holder_type:
            continue
        for f in t.get("fibery/fields", []):
            if f.get("fibery/name") == field_name:
                target_type = f.get("fibery/type")
                break
        break
    if not target_type:
        print(f"[fibery] ERROR: field '{field_name}' not found on '{holder_type}'", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)

    # Find the title field on the target type
    title_field = None
    for t in types:
        if t.get("fibery/name") != target_type:
            continue
        for f in t.get("fibery/fields", []):
            meta = f.get("fibery/meta", {}) or {}
            if meta.get("ui/title?"):
                title_field = f.get("fibery/name")
                break
        # Enum types use enum/name
        if not title_field:
            for f in t.get("fibery/fields", []):
                if f.get("fibery/name") == "enum/name":
                    title_field = "enum/name"
                    break
        break

    if not title_field:
        print(f"[fibery] ERROR: cannot find title field on '{target_type}'", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)

    names = [n.strip() for n in names_csv.split(",") if n.strip()]
    conditions = [["=", [title_field], f"$n{i}"] for i, _ in enumerate(names)]
    where = conditions[0] if len(conditions) == 1 else ["q/or"] + conditions
    params = {f"$n{i}": n for i, n in enumerate(names)}

    result = post_command(ctx, "fibery.entity/query", {
        "query": {
            "q/from": target_type,
            "q/select": {"fibery/id": ["fibery/id"], "name": [title_field]},
            "q/where": where,
            "q/limit": len(names) + 10,
        },
        "params": params,
    })
    if not result:
        print(f"[fibery] ERROR: no entities found matching {names} in {target_type}", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)
    return [{"fibery/id": r["fibery/id"]} for r in result]


# ---------- Space management (undocumented: fibery.app/save) ----------

def cmd_space(ctx: Ctx, args: argparse.Namespace) -> None:
    """Manage spaces: create, list, delete."""
    import uuid as _uuid

    op = args.space_op
    if op == "list":
        result = post_command(ctx, "fibery.entity/query", {
            "query": {
                "q/from": "fibery/app",
                "q/select": {
                    "fibery/id": ["fibery/id"],
                    "fibery/name": ["fibery/name"],
                    "fibery/title": ["fibery/title"],
                    "fibery/status": ["fibery/status"],
                    "fibery/color": ["fibery/color"],
                    "fibery/icon": ["fibery/icon"],
                    "fibery/version": ["fibery/version"],
                },
                "q/limit": 200,
            },
        })
        # Filter out system apps unless --all
        if not args.all:
            result = [a for a in result
                      if a.get("fibery/name") not in ("fibery", "Collaboration~Documents")
                      and not a.get("fibery/name", "").startswith("fibery/")]
        emit(result, args.output)
        return

    if op == "create":
        space_id = str(_uuid.uuid4())
        payload = [{
            "command": "fibery.command/batch",
            "args": {
                "commands": [
                    {
                        "command": "fibery.app/save",
                        "args": {
                            "app": {
                                "fibery/id": space_id,
                                "fibery/name": args.name,
                                "fibery/title": args.name,
                                "fibery/namespace": args.name,
                                "fibery/description": args.description or "",
                                "fibery/version": "1.0.0",
                                "fibery/show-in-menu?": True,
                                "fibery/color": args.color or "#F7D130",
                                "fibery/icon": args.icon or "puzzle-piece",
                                "fibery/status": "app/installed",
                                "fibery/categories": [],
                                "fibery/created-by": "",
                                "fibery/schema": {
                                    "fibery/name": args.name,
                                    "fibery/types": [],
                                },
                            }
                        }
                    },
                    {
                        "command": "fibery.app/install",
                        "args": {"name": args.name, "version": "1.0.0"},
                    },
                ]
            }
        }]
        results = post_commands(ctx, payload)
        emit({"created": args.name, "id": space_id, "result": results}, args.output)
        return

    if op == "delete":
        if not args.yes:
            print("[fibery] ERROR: space delete requires --yes", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)
        # Resolve space name to ID
        spaces = post_command(ctx, "fibery.entity/query", {
            "query": {
                "q/from": "fibery/app",
                "q/select": {"fibery/id": ["fibery/id"], "fibery/name": ["fibery/name"]},
                "q/where": ["=", ["fibery/name"], "$n"],
                "q/limit": 1,
            },
            "params": {"$n": args.name},
        })
        if not spaces:
            print(f"[fibery] ERROR: space '{args.name}' not found", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)
        app_id = spaces[0]["fibery/id"]

        # Delete all types in the space first
        schema = post_command(ctx, "fibery.schema/query", {})
        space_types = [t["fibery/name"] for t in schema.get("fibery/types", [])
                       if t["fibery/name"].startswith(f"{args.name}/")
                       and (t.get("fibery/meta", {}) or {}).get("fibery/domain?")]
        if space_types:
            del_cmds = [{"command": "schema.type/delete", "args": {
                "name": tn, "delete-entities?": True, "delete-related-fields?": True,
            }} for tn in space_types]
            post_command(ctx, "fibery.schema/batch", {"commands": del_cmds})

        # Uninstall then delete
        post_command(ctx, "fibery.app/uninstall", {"fibery/id": app_id})
        post_command(ctx, "fibery.app/delete", {"fibery/id": app_id})
        emit({"deleted": args.name, "id": app_id, "types_removed": space_types}, args.output)
        return

    if op == "update":
        spaces = post_command(ctx, "fibery.entity/query", {
            "query": {
                "q/from": "fibery/app",
                "q/select": {"fibery/id": ["fibery/id"]},
                "q/where": ["=", ["fibery/name"], "$n"],
                "q/limit": 1,
            },
            "params": {"$n": args.name},
        })
        if not spaces:
            print(f"[fibery] ERROR: space '{args.name}' not found", file=sys.stderr)
            sys.exit(EXIT_USER_ERROR)
        app_id = spaces[0]["fibery/id"]
        update = {"fibery/id": app_id}
        if args.color:
            update["fibery/color"] = args.color
        if args.icon:
            update["fibery/icon"] = args.icon
        result = post_command(ctx, "fibery.command/batch", {"commands": [
            {"command": "fibery.app/update", "args": update},
        ]})
        emit({"updated": args.name, "id": app_id, "result": result}, args.output)
        return


