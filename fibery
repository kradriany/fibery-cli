# ---------- Batch doc fetch + incremental sync ----------

def cmd_docs_batch(ctx: Ctx, args: argparse.Namespace) -> None:
    """Fetch multiple documents in a single API call using the undocumented
    POST /api/documents/commands endpoint with get-documents command.

    Falls back to sequential single-doc fetches if the batch endpoint fails.
    """
    if args.secrets_file:
        with open(args.secrets_file) as f:
            secrets = [line.strip() for line in f if line.strip()]
    elif args.secrets:
        secrets = [s.strip() for s in args.secrets.split(",") if s.strip()]
    elif not sys.stdin.isatty():
        secrets = [line.strip() for line in sys.stdin if line.strip()]
    else:
        print("[fibery] ERROR: docs-batch needs --secrets, --secrets-file, or stdin", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)

    fmt = args.format
    r = ctx.client.post(
        ctx.url(f"/api/documents/commands?format={fmt}"),
        headers=ctx.headers(),
        json={"command": "get-documents", "args": [{"secret": s} for s in secrets]},
        timeout=60.0,
    )
    if r.is_success:
        data = r.json()
        if isinstance(data, list):
            for doc in data:
                print(json.dumps(doc, default=str))
            return
    # Fallback to sequential
    import time as _time
    for i, secret in enumerate(secrets):
        try:
            doc = _get_document(ctx, secret, fmt)
            print(json.dumps(doc, default=str))
        except SystemExit:
            print(json.dumps({"secret": secret, "_error": "fetch failed"}))
        if i < len(secrets) - 1:
            _time.sleep(0.35)


def cmd_docs_sync(ctx: Ctx, args: argparse.Namespace) -> None:
    """Incremental doc sync using entity modification-date as change signal.

    Queries entities modified since last run, fetches their doc content,
    saves to a local cache directory. State file tracks last-run timestamp.
    """
    import time as _time
    from pathlib import Path

    cache_dir = Path(args.cache_dir)
    cache_dir.mkdir(parents=True, exist_ok=True)
    state_file = cache_dir / ".sync-state.json"

    # Load last-run timestamp
    last_run = None
    if state_file.exists():
        with open(state_file) as f:
            state = json.load(f)
            last_run = state.get("last_run")

    # Query entities, optionally filtered by modification date
    query: dict[str, Any] = {
        "q/from": args.type,
        "q/select": {
            "fibery/id": ["fibery/id"],
            "fibery/modification-date": ["fibery/modification-date"],
            "doc-secret": [args.field, "Collaboration~Documents/secret"],
        },
        "q/order-by": [[["fibery/modification-date"], "q/asc"]],
        "q/limit": args.limit,
    }
    params: dict[str, Any] = {}

    if last_run and not args.full:
        query["q/where"] = [">", ["fibery/modification-date"], "$since"]
        params["$since"] = last_run

    entities = post_command(ctx, "fibery.entity/query", {"query": query, "params": params})

    if not entities:
        emit({"synced": 0, "since": last_run, "message": "no changes"}, args.output)
        return

    fmt = args.format
    synced = 0
    errors = 0
    for i, entity in enumerate(entities):
        eid = entity.get("fibery/id", "unknown")
        secret = entity.get("doc-secret")
        if not secret:
            continue
        try:
            doc = _get_document(ctx, secret, fmt)
            content = doc.get("content", "") if isinstance(doc, dict) else doc
            out_file = cache_dir / f"{eid}.{fmt}"
            with open(out_file, "w") as f:
                if fmt == "json":
                    json.dump(content, f, indent=2, default=str)
                else:
                    f.write(content if isinstance(content, str) else json.dumps(content))
            synced += 1
        except SystemExit:
            errors += 1
        if i < len(entities) - 1:
            _time.sleep(0.35)

    # Update state
    latest_mod = max(e.get("fibery/modification-date", "") for e in entities)
    with open(state_file, "w") as f:
        json.dump({"last_run": latest_mod, "synced": synced, "errors": errors}, f)

    emit({
        "synced": synced,
        "errors": errors,
        "since": last_run,
        "latest": latest_mod,
        "cache_dir": str(cache_dir),
    }, args.output)


# ---------- View management (JSON-RPC) ----------

def _view_rpc(ctx: Ctx, method: str, params: dict[str, Any]) -> Any:
    """Call /api/views/json-rpc with a method and params."""
    r = ctx.client.post(
        ctx.url("/api/views/json-rpc"),
        headers=ctx.headers(),
        json={"jsonrpc": "2.0", "method": method, "params": params, "id": f"cli-{method}"},
        timeout=30.0,
    )
    if not r.is_success:
        http_error(r)
    data = r.json()
    if "error" in data:
        print(f"[fibery] ERROR: {method}: {data['error'].get('message', data['error'])}", file=sys.stderr)
        sys.exit(EXIT_API_ERROR)
    return data.get("result", data)


