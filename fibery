def cmd_comments(ctx: Ctx, args: argparse.Namespace) -> None:
    """Fetch threaded comments on an entity. Traverses comments/comments relation.

    The parent type MUST have comments/comments-mixin installed. Pass --type to
    specify the parent database. Optionally fetch comment body content with --with-content.
    """
    query = {
        "q/from": args.type,
        "q/select": {
            "fibery/id": ["fibery/id"],
            "comments": {
                "q/from": ["comments/comments"],
                "q/select": {
                    "fibery/id": ["fibery/id"],
                    "fibery/public-id": ["fibery/public-id"],
                    "document-secret": ["comment/document-secret"],
                    "author-id": ["comment/author", "fibery/id"],
                    "author-name": ["comment/author", "user/name"],
                    "parent-id": ["comments/parent", "fibery/id"],
                    "created": ["fibery/creation-date"],
                },
                "q/limit": "q/no-limit",
            },
        },
        "q/where": ["=", ["fibery/id"], "$entityId"],
        "q/limit": 1,
    }
    result = post_command(ctx, "fibery.entity/query", {
        "query": query,
        "params": {"$entityId": args.id},
    })
    if not isinstance(result, list) or not result:
        print(f"[fibery] ERROR: Entity {args.id} not found in {args.type}", file=sys.stderr)
        sys.exit(EXIT_USER_ERROR)
    comments = result[0].get("comments", [])
    comments.sort(key=lambda c: c.get("created", ""))

    if args.with_content:
        for c in comments:
            secret = c.get("document-secret")
            if secret:
                try:
                    doc = _get_document(ctx, secret, args.format)
                    c["content"] = doc.get("content", "") if isinstance(doc, dict) else doc
                except SystemExit:
                    c["content"] = None
                    c["content_error"] = "failed to fetch document"

    emit(comments, args.output)


def cmd_comment_add(ctx: Ctx, args: argparse.Namespace) -> None:
    """Create a comment on an entity. Three steps: create comment entity with
    a new doc secret, attach it to the parent via add-collection-items, then
    write the content to the document.
    """
    import uuid as _uuid
    doc_secret = str(_uuid.uuid4())

    # Step 1: create comment entity
    comment = post_command(ctx, "fibery.entity/create", {
        "type": "comments/comment",
        "entity": {"comment/document-secret": doc_secret},
    })
    comment_id = comment["fibery/id"]

    # Step 2: attach to parent entity
    post_command(ctx, "fibery.entity/add-collection-items", {
        "type": args.type,
        "entity": {"fibery/id": args.id},
        "field": "comments/comments",
        "items": [{"fibery/id": comment_id}],
    })

    # Step 3: write content
    if args.content:
        content = args.content
    elif args.content_file:
        with open(args.content_file) as f:
            content = f.read()
    elif not sys.stdin.isatty():
        content = sys.stdin.read()
    else:
        content = ""

    if content:
        ctx.client.put(
            ctx.url(f"/api/documents/{doc_secret}"),
            headers=ctx.headers(),
            json={"content": content, "format": "md"},
            timeout=30.0,
        )

    emit({
        "comment_id": comment_id,
        "entity": args.id,
        "type": args.type,
        "doc_secret": doc_secret,
        "content_length": len(content),
    }, args.output)


