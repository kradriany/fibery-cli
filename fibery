def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    config = load_config()
    host = resolve_host(args.workspace, workspace_host=args.workspace_host, config=config)
    token = get_token(host, workspace=args.workspace, token=args.token, config=config)

    with httpx.Client(timeout=30.0) as client:
        ctx = Ctx(workspace=args.workspace, host=host, token=token, client=client)
        handler = HANDLERS.get(args.command)
        if not handler:
            parser.error(f"Unknown command: {args.command}")
        handler(ctx, args)


if __name__ == "__main__":
    main()
